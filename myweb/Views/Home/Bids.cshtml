
@{
    ViewData["Title"] = "Bids";
}

<h1>Bids</h1>

@if (Model.Count == 0)
{
    <p>No Bids yet.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Amount</th>
                <th>Bid Date</th>
                <th>Client Info</th>
                <th>Car Info</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bid in Model)
            {
                <tr>
                    <td>@bid.Id</td>
                    <td>@bid.Amount</td>
                    <td>@bid.BidDate.ToString("dd/MM/yyyy")</td>
                    <td>@bid.Client?.FullName</td>
                    <td>@bid.Car?.Brand</td>
                </tr>
            }
        </tbody>
    </table>
}