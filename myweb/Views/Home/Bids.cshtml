
@{
    ViewData["Title"] = "Bids";
}

<h1>Bids</h1>

@if (Model.Count == 0)
{
    <p>No Bids yet.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Amount/th>
                <th>Bid Date</th>
                <th>Client ID</th>
                <th>Client Info</th>
                <th>Car Id</th>
                <th>Car Info</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var car in Model)
            {
                <tr>
                    <td>@car.Id</td>
                    <td>@car.Amount</td>
                    <td>@car.BidDate.JoinDate.ToString("dd/MM/yyyy")</td>
                    <td>@car.ClientId</td>
                    <td>@car.Client</td>
                    <td>@car.CarId</td>
                    <td>@car.Car</td>
                </tr>
            }
        </tbody>
    </table>
}