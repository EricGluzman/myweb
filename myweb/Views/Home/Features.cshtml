
@{
    ViewData["Title"] = "Features";
}

<h1>Features</h1>

@if (Model.Count == 0)
{
    <p>No Features yet.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Description</th>
                <th>Car</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var feature in Model)
            {
                <tr>
                    <td>@feature.Id</td>
                    <td>@feature.Name</td>
                    <td>@feature.Description</td>
                    <td>
                        @if (feature.Cars.Count == 0)
                        {
                            <span class="text-muted">None</span>
                        }
                        else
                        {
                            <ul class="mb-0">
                                @foreach (var car in feature.Cars)
                                {
                                    <li>@car.Brand</li>
                                }
                            </ul>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
