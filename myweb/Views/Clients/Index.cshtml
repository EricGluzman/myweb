@model List<myweb.Models.Client>
@{
    ViewData["Title"] = "Clients";
}

<h1>Clients</h1>

@if (Model.Count == 0)
{
    <p>No clients yet.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Join Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in Model)
            {
                <tr>
                    <td>@client.Id</td>
                    <td>@client.FullName</td>
                    <td>@client.Email</td>
                    <td>@client.Phone</td>
                    <td>@client.JoinDate.ToString("dd/MM/yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
}
