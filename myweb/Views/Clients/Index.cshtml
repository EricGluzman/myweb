@model List<myweb.Models.Client>
@{
    ViewData["Title"] = "Clients";
}

<h1>Clients</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

@if (Model.Count == 0)
{
    <p>No clients yet.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Join Date</th>
                <th>Bid Id</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in Model)
            {
                <tr>
                    <td>@client.Id</td>
                    <td>@client.FullName</td>
                    <td>@client.Email</td>
                    <td>@client.Phone</td>
                    <td>@client.JoinDate.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (client.Bids.Count == 0)
                        {
                            <span class="text-muted">None</span>
                        }
                        else
                        {
                            <ul class="mb-0">
                                @foreach (var bid in client.Bids)
                                {
                                    <li>@bid.Id</li>
                                }
                            </ul>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@client.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@client.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@client.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
